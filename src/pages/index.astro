---
import MinicourseLanding from '../components/landing/MinicourseLanding.astro';
import '../components/calculator/calculator.css';
import '../components/landing/minicourse.css';
import '../components/registration/registration.css';
---

<!doctype html>
<html lang="ru">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta
      name="description"
      content="Первый разбор: семидневная учебная проба консультирования. Контур 22 — вымышленная школа и портфолио-концепт с локальной демозаписью."
    />
    <title>Контур 22 — первый разбор, профессия на пробу</title>
  </head>
  <body class="theme-matte selected-mockup">
    <!--
      THESIS: Одна учебная проба показана через кейс и его доработку.
      OWN-WORLD: Принятая «Матовая практика», Onest, navy/paper/vermilion/amber.
      STORY: Предложение, учебный пример, условия, необязательный калькулятор, локальная демозапись.
      FIRST VIEWPORT: Полный оффер и заполненный лист Елены о возвращении к рисованию.
      FORM: Направление А и исправленные макеты приняты Викторией 29.10.2026.
      FINISH: Реализация проверяется в этой ограниченной задаче; приёмка и закрытие фазы остаются за Викторией.
    -->
    <MinicourseLanding />
  </body>
</html>
